[zh-cn]
name = "DrawDB 数据库 ER 图设计器"
auth = "ericbyz"
descript = "可视化设计数据库 ER 图:拖拽建表、定义字段与关系,一键导出 MySQL/PostgreSQL/SQLite/MariaDB/MSSQL 等 SQL,支持 DBML 导入导出。纯静态应用(无后台服务、不占端口),由 TOS 网页服务直接托管,悬浮窗内直接使用。基于上游 v1.9.0 锁定 commit 构建(AGPL-3.0),monaco 编辑器与图标字体全部本地化,内网环境开箱即用。"
note = "1. 基于上游 drawdb-io/drawdb(AGPL-3.0)锁定 commit 构建并封装为 TOS 应用。"

[zh-hk]
name = "DrawDB 數據庫 ER 圖設計器"
auth = "ericbyz"
descript = "可視化設計數據庫 ER 圖:拖拽建表、定義字段與關係,一鍵導出 MySQL/PostgreSQL/SQLite/MariaDB/MSSQL 等 SQL,支持 DBML 導入導出。純靜態應用(無後台服務、不佔端口)。"
note = "1. 基于上游 drawdb-io/drawdb(AGPL-3.0)锁定 commit 构建并封装为 TOS 应用。"

[en-us]
name = "DrawDB ER Diagram Editor"
auth = "ericbyz"
descript = "Database entity-relationship diagram editor: design ER diagrams visually, export SQL for MySQL/PostgreSQL/SQLite/MariaDB/MSSQL and more, import DBML, and generate diagrams from existing schemas. Pure static app served by the TOS web server (no background service, no extra port). Built from upstream drawdb-io/drawdb v1.9.0 (AGPL-3.0) with all assets bundled locally (intranet-safe)."
note = "1. Built from upstream drawdb-io/drawdb (AGPL-3.0) at a pinned commit for TOS."

[ko-kr]
name = "DrawDB ER Diagram Editor"
auth = "ericbyz"
descript = "데이터베이스 ER 다이어그램 편집기: 테이블을 드래그로 만들고 필드·관계를 정의하며 MySQL/PostgreSQL/SQLite 등으로 SQL을 내보내고 DBML을 지원합니다. 백그라운드 서비스가 없는 순정적 앱. 업스트림 v1.9.0 고정 커밋 빌드(AGPL-3.0), 모든 에셋 로컬 제공."
note = "1. Built from upstream drawdb-io/drawdb (AGPL-3.0) at a pinned commit for TOS."

